.local/

# Reproducible local caches and generated Stratasys slice stacks.
**/__pycache__/
work/uv-cache/
work/fur/floating_fur_native_labels.dat
work/*/*_voxelprint_staging/

# Generated renders and voxel volumes are never tracked. Archived copies of what
# was actually printed live under .local/real_print/<batch>/; the photos,
# sessions, reports and final figures are tracked in casestudy/real_print/.
outputs/
!casestudy/**/outputs/
work/amber/kohaku_tree_build/*.npy
work/amber/kohaku_tree_build/*.voxels.json
work/amber/seed-*/
